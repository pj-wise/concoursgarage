# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://theconcoursgaragellc.com

# Optional: deliver form submissions (RSVP, Submit Your Car, tour requests) by email via Resend.
# Without these, forms fall back to opening the visitor's email app with the message prefilled.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL="The Concours Garage <website@concoursgarage.com>"
INQUIRY_TO_EMAIL=info@concoursgarage.com
